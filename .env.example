# Copy this file to ".env" and fill it in. NEVER commit ".env" (it is git-ignored).
# On the host (Render/Railway) enter these in the dashboard instead of uploading a file.

# --- Required in production ---------------------------------------------------
NODE_ENV=production
# Your WhatsApp number, digits only, international format, no "+": 254740449384
WHATSAPP_NUMBER=
# The exact public address of the site, https, no trailing path: https://wildstrides.co.ke
SITE_URL=

# --- Optional (the defaults are right for almost everyone) -----------------------
# The host sets PORT itself. Only set it for local use.
# PORT=4000
# How many proxies sit in front of the app. 1 = Render/Railway. Use 2 if you add Cloudflare on top. 0 = none.
# TRUST_PROXY=1
# Security policy for the page: enforce (default) | report-only (logs only, blocks nothing) | off
# Emergency lever: if photos/fonts ever stop loading after you add a new external source, set report-only.
# CSP_MODE=enforce
# Page requests allowed per visitor IP per 15 minutes (images and files are never counted).
# RATE_LIMIT_MAX=1000
