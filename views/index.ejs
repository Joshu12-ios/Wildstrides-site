  #about-cta { padding: 110px 60px; background: var(--rust); position: relative; overflow: hidden; text-align: center; }
  #about-cta::before { content: ''; position: absolute; inset: 0; background: url('https://images.unsplash.com/photo-1489392191049-fc10c97e64b6?w=1920&q=50') center/cover; opacity: .12; }
