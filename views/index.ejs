<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WILDSTRIDES — Mt. Kenya Safari & Adventure Experiences</title>
<meta name="description" content="WildStrides Kenya: guided Mt. Kenya treks, Ol Pejeta safaris and highland adventures. Send an enquiry and our team will confirm everything with you on WhatsApp.">
<meta name="theme-color" content="#1A0F08">
<meta property="og:type" content="website">
<meta property="og:title" content="WildStrides Kenya: Mt. Kenya Safari and Adventure Experiences">
<meta property="og:description" content="WildStrides Kenya: guided Mt. Kenya treks, Ol Pejeta safaris and highland adventures. Send an enquiry and our team will confirm everything with you on WhatsApp.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🏔️%3C/text%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
<style>
  :root {
    --earth:   #2C1810;
    --savanna: #D4A853;
    --rust:    #C4612B;
    --sage:    #4A6741;
    --cream:   #F5EDD8;
    --sand:    #E8D5A3;
    --dark:    #1A0F08;
    --white:   #FDFAF4;
    --accent:  #E8752A;
    --alpine:  #2E4A3E;
    --mist:    #7A9B8A;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; overflow-x: hidden; }
  body {
    font-family: 'Montserrat', sans-serif;
    background: var(--dark);
    color: var(--cream);
    overflow-x: hidden;
    width: 100%;
  }

  /* ── NAVIGATION ─────────────────────────────────────── */
  nav {
    position: fixed; top: 0; width: 100%; z-index: 1000;
    padding: 20px 60px;
    display: flex; align-items: center; justify-content: space-between;
    background: linear-gradient(to bottom, rgba(26,15,8,0.95), transparent);
    backdrop-filter: blur(2px);
    transition: background 0.3s;
  }
  nav.scrolled { background: rgba(26,15,8,0.98); }
  .logo {
    font-family: 'Playfair Display', serif;
    font-size: 28px; font-weight: 900;
    color: var(--savanna); letter-spacing: 4px;
    text-decoration: none;
  }
  .logo span { color: var(--rust); }
  .nav-links { display: flex; gap: 35px; list-style: none; }
  .nav-links a {
    color: var(--cream); text-decoration: none;
    font-size: 12px; letter-spacing: 2px; text-transform: uppercase;
    font-weight: 600; opacity: 0.85;
    transition: all 0.3s; cursor: pointer;
  }
  .nav-links a:hover { color: var(--savanna); opacity: 1; }
  .nav-cta {
    background: var(--rust); color: var(--white);
    border: none; padding: 12px 28px;
    font-family: 'Montserrat', sans-serif;
    font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
    font-weight: 600; cursor: pointer; transition: all 0.3s;
  }
  .nav-cta:hover { background: var(--savanna); transform: translateY(-2px); }

  /* ── HERO ────────────────────────────────────────────── */
  #hero {
    height: 100vh; position: relative;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute; inset: 0;
    background:
      linear-gradient(to bottom, rgba(26,15,8,0.2) 0%, rgba(26,15,8,0.75) 100%),
      url('https://images.unsplash.com/photo-1489392191049-fc10c97e64b6?w=1920&q=80') center/cover;
    animation: slowZoom 20s ease-in-out infinite alternate;
  }
  @keyframes slowZoom {
    from { transform: scale(1); }
    to   { transform: scale(1.08); }
  }
  .hero-content {
    position: relative; text-align: center;
    animation: fadeUp 1.2s ease forwards;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(40px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .hero-eyebrow {
    font-size: 12px; letter-spacing: 6px; text-transform: uppercase;
    color: var(--savanna); margin-bottom: 20px; font-weight: 600;
  }
  .hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(64px, 10vw, 130px);
    font-weight: 900; line-height: 0.9;
    color: var(--white);
    text-shadow: 0 4px 40px rgba(0,0,0,0.5);
  }
  .hero-title em {
    font-style: italic; color: var(--savanna);
    display: block; font-size: 0.7em;
  }
  .hero-sub {
    margin-top: 30px; font-size: 16px; color: var(--sand);
    font-family: 'Libre Baskerville', serif; font-style: italic;
    max-width: 520px; margin-left: auto; margin-right: auto; line-height: 1.7;
  }
  .hero-buttons {
    margin-top: 50px; display: flex; gap: 20px; justify-content: center; flex-wrap: wrap;
  }
  .btn-primary {
    background: var(--rust); color: var(--white);
    border: none; padding: 18px 45px;
    font-family: 'Montserrat', sans-serif;
    font-size: 12px; letter-spacing: 3px; text-transform: uppercase;
    font-weight: 700; cursor: pointer; transition: all 0.3s;
  }
  .btn-primary:hover { background: var(--savanna); transform: translateY(-3px); box-shadow: 0 15px 40px rgba(212,168,83,0.3); }
  .btn-outline {
    background: transparent; color: var(--white);
    border: 1px solid rgba(255,255,255,0.5); padding: 18px 45px;
    font-family: 'Montserrat', sans-serif;
    font-size: 12px; letter-spacing: 3px; text-transform: uppercase;
    font-weight: 600; cursor: pointer; transition: all 0.3s;
  }
  .btn-outline:hover { border-color: var(--savanna); color: var(--savanna); }
  .scroll-indicator {
    position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    color: var(--sand); font-size: 10px; letter-spacing: 3px; text-transform: uppercase;
    animation: bounce 2s infinite;
  }
  @keyframes bounce {
    0%,100% { transform: translateX(-50%) translateY(0); }
    50%      { transform: translateX(-50%) translateY(10px); }
  }
  .scroll-line { width: 1px; height: 50px; background: linear-gradient(to bottom, var(--savanna), transparent); }

  /* ── SECTION COMMONS ─────────────────────────────────── */
  section { position: relative; }
  .section-header { text-align: center; margin-bottom: 70px; }
  .section-tag {
    font-size: 11px; letter-spacing: 5px; text-transform: uppercase;
    color: var(--rust); font-weight: 600; margin-bottom: 15px; display: block;
  }
  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(36px, 5vw, 60px); font-weight: 900;
    line-height: 1.1; color: var(--cream);
  }
  .section-title em { font-style: italic; color: var(--savanna); }
  .section-desc {
    font-family: 'Libre Baskerville', serif; font-style: italic;
    color: var(--sand); font-size: 16px; line-height: 1.8;
    max-width: 600px; margin: 20px auto 0;
  }

  /* ── DESTINATIONS ────────────────────────────────────── */
  #destinations {
    padding: 120px 60px;
    background: linear-gradient(to bottom, var(--dark), #0F0804);
  }
  .destinations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 30px; max-width: 1300px; margin: 0 auto;
  }
  .destination-card {
    position: relative; overflow: hidden; cursor: pointer;
    border: 1px solid rgba(212,168,83,0.15);
    transition: transform 0.4s, box-shadow 0.4s;
    animation: fadeIn 0.6s ease forwards; opacity: 0;
  }
  .destination-card:hover { transform: translateY(-8px); box-shadow: 0 30px 60px rgba(0,0,0,0.6); }
  .destination-card:nth-child(1) { animation-delay: 0.1s; }
  .destination-card:nth-child(2) { animation-delay: 0.2s; }
  .destination-card:nth-child(3) { animation-delay: 0.3s; }
  .destination-card:nth-child(4) { animation-delay: 0.4s; }
  .destination-card:nth-child(5) { animation-delay: 0.5s; }
  .destination-card:nth-child(6) { animation-delay: 0.6s; }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .dest-img {
    width: 100%; height: 280px; object-fit: cover;
    transition: transform 0.6s; display: block;
  }
  .destination-card:hover .dest-img { transform: scale(1.07); }
  .dest-img-placeholder {
    width: 100%; height: 280px;
    background-size: cover; background-position: center;
    transition: transform 0.6s;
  }
  .destination-card:hover .dest-img-placeholder { transform: scale(1.07); }
  .dest-info {
    padding: 28px;
    background: linear-gradient(to bottom, rgba(26,15,8,0.95), var(--earth));
  }
  .dest-region {
    font-size: 10px; letter-spacing: 3px; text-transform: uppercase;
    color: var(--rust); font-weight: 600; margin-bottom: 8px;
  }
  .dest-name {
    font-family: 'Playfair Display', serif;
    font-size: 24px; font-weight: 700; color: var(--cream); margin-bottom: 10px;
  }
  .dest-desc { font-size: 13px; color: var(--sand); line-height: 1.7; margin-bottom: 20px; }
  .dest-highlights { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px; }
  .highlight-tag {
    background: rgba(212,168,83,0.15); border: 1px solid rgba(212,168,83,0.3);
    color: var(--savanna); font-size: 10px; letter-spacing: 1px;
    padding: 4px 12px; text-transform: uppercase;
  }
  .dest-footer { display: flex; align-items: center; justify-content: space-between; }
  .dest-price {
    font-family: 'Playfair Display', serif;
    font-size: 22px; color: var(--savanna); font-weight: 700;
  }
  .dest-price span { font-size: 12px; color: var(--sand); font-family: 'Montserrat', sans-serif; }
  .dest-btn {
    background: transparent; border: 1px solid var(--rust);
    color: var(--rust); padding: 10px 20px;
    font-size: 10px; letter-spacing: 2px; text-transform: uppercase;
    font-weight: 600; cursor: pointer; transition: all 0.3s;
  }
  .dest-btn:hover { background: var(--rust); color: var(--white); }

  /* ── PACKAGES ────────────────────────────────────────── */
  #packages {
    padding: 120px 60px;
    background: var(--cream);
    position: relative; overflow: hidden;
  }
  #packages::before {
    content: 'MT KENYA';
    position: absolute; top: -20px; left: -40px;
    font-family: 'Playfair Display', serif;
    font-size: 200px; font-weight: 900; font-style: italic;
    color: rgba(44,24,16,0.05); pointer-events: none; white-space: nowrap;
  }
  #packages .section-title { color: var(--earth); }
  #packages .section-desc { color: #7A5C3A; }
  .packages-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 25px; max-width: 1300px; margin: 0 auto;
  }
  .package-card {
    background: var(--white); border: 1px solid rgba(44,24,16,0.1);
    padding: 45px 35px; position: relative; overflow: hidden;
    transition: all 0.4s; cursor: pointer;
  }
  .package-card:hover { transform: translateY(-6px); box-shadow: 0 25px 50px rgba(44,24,16,0.15); }
  .package-card.featured { background: var(--earth); border-color: var(--savanna); }
  .package-card.featured .package-name,
  .package-card.featured .package-price-val,
  .package-card.featured .package-includes li { color: var(--cream); }
  .package-card.featured .package-tagline { color: var(--sand); }
  .package-card.featured .package-includes li::before { color: var(--savanna); }
  .featured-badge {
    position: absolute; top: 20px; right: -30px;
    background: var(--rust); color: var(--white);
    font-size: 9px; letter-spacing: 2px; text-transform: uppercase;
    font-weight: 700; padding: 6px 50px; transform: rotate(45deg);
  }
  .package-icon { font-size: 40px; margin-bottom: 20px; }
  .package-name {
    font-family: 'Playfair Display', serif;
    font-size: 26px; font-weight: 700; color: var(--earth); margin-bottom: 8px;
  }
  .package-tagline {
    font-family: 'Libre Baskerville', serif; font-style: italic;
    color: #7A5C3A; font-size: 14px; margin-bottom: 25px;
  }
  .package-price {
    margin-bottom: 25px; padding-bottom: 25px;
    border-bottom: 1px solid rgba(44,24,16,0.1);
  }
  .package-card.featured .package-price { border-color: rgba(212,168,83,0.3); }
  .package-price-label { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--rust); font-weight: 600; }
  .package-price-val {
    font-family: 'Playfair Display', serif;
    font-size: 42px; font-weight: 900; color: var(--earth); line-height: 1;
  }
  .package-price-period { font-size: 13px; color: #7A5C3A; }
  .package-includes { list-style: none; margin-bottom: 35px; }
  .package-includes li {
    font-size: 13px; color: var(--earth); padding: 6px 0;
    padding-left: 20px; position: relative;
  }
  .package-includes li::before {
    content: '✦'; position: absolute; left: 0;
    color: var(--rust); font-size: 8px; top: 9px;
  }
  .pkg-btn {
    width: 100%; padding: 16px;
    font-family: 'Montserrat', sans-serif;
    font-size: 11px; letter-spacing: 3px; text-transform: uppercase; font-weight: 700;
    cursor: pointer; transition: all 0.3s; border: none;
    background: var(--rust); color: var(--white);
  }
  .package-card.featured .pkg-btn { background: var(--savanna); }
  .pkg-btn:hover { opacity: 0.85; transform: translateY(-2px); }

  /* ── BOOKING MODAL ────────────────────────────────────── */
  .modal-overlay {
    display: none; position: fixed; inset: 0;
    background: rgba(15,8,4,0.95); z-index: 2000;
    align-items: center; justify-content: center;
  }
  .modal-overlay.active { display: flex; }
  .modal {
    background: var(--earth); border: 1px solid rgba(212,168,83,0.3);
    padding: 60px; max-width: 560px; width: 90%;
    position: relative; animation: slideUp 0.4s ease;
    max-height: 90vh; overflow-y: auto;
  }
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .modal-close {
    position: absolute; top: 20px; right: 25px;
    background: none; border: none; color: var(--sand);
    font-size: 24px; cursor: pointer; line-height: 1;
  }
  .modal-title {
    font-family: 'Playfair Display', serif;
    font-size: 32px; color: var(--savanna); margin-bottom: 8px;
  }
  .modal-sub { color: var(--sand); font-size: 14px; margin-bottom: 25px; line-height: 1.7; }
  .form-group { margin-bottom: 20px; }
  .form-label {
    display: block; font-size: 10px; letter-spacing: 2px;
    text-transform: uppercase; color: var(--savanna);
    font-weight: 600; margin-bottom: 8px;
  }
  .form-input, .form-select {
    width: 100%; padding: 14px 18px;
    background: rgba(255,255,255,0.06); border: 1px solid rgba(212,168,83,0.25);
    color: var(--cream); font-family: 'Montserrat', sans-serif; font-size: 14px;
    outline: none; transition: border-color 0.3s; -webkit-appearance: none;
  }
  .form-input:focus, .form-select:focus { border-color: var(--savanna); }
  .form-select option { background: var(--earth); color: var(--cream); }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
  .booking-note {
    background: rgba(212,168,83,0.1); border: 1px solid rgba(212,168,83,0.2);
    padding: 18px; margin-bottom: 20px;
  }
  .booking-note p { font-size: 13px; color: var(--sand); line-height: 1.65; }
  .booking-note strong { color: var(--savanna); }
  .total-line {
    display: flex; justify-content: space-between; align-items: center;
    gap: 16px; padding: 20px 0; border-top: 1px solid rgba(212,168,83,0.2); margin-bottom: 20px;
  }
  .total-label { font-size: 13px; color: var(--sand); }
  .total-amount { font-family: 'Playfair Display', serif; font-size: 22px; color: var(--savanna); text-align: right; }
  .action-btn {
    width: 100%; padding: 18px;
    background: var(--rust); color: var(--white);
    border: none; font-family: 'Montserrat', sans-serif;
    font-size: 13px; letter-spacing: 2px; text-transform: uppercase;
    font-weight: 700; cursor: pointer; transition: all 0.3s;
  }
  .action-btn:hover { background: var(--savanna); }
  .action-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .action-btn.booking-btn { background: #168A43; }
  .action-btn.booking-btn:hover { background: #20A553; }

  /* ── ADVERTISE ───────────────────────────────────────── */
  #advertise {
    padding: 120px 60px;
    background: linear-gradient(135deg, #0F0804, #1A0F08);
  }
  .advertise-options {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 25px; max-width: 1100px; margin: 0 auto 80px;
  }
  .advert-card {
    border: 1px solid rgba(212,168,83,0.2); padding: 40px 30px;
    background: rgba(44,24,16,0.5); transition: all 0.3s;
  }
  .advert-card:hover { border-color: var(--savanna); transform: translateY(-4px); }
  .advert-icon { font-size: 35px; margin-bottom: 18px; }
  .advert-title {
    font-family: 'Playfair Display', serif;
    font-size: 22px; color: var(--cream); margin-bottom: 10px;
  }
  .advert-desc { font-size: 13px; color: var(--sand); line-height: 1.7; margin-bottom: 20px; }
  .advert-price { font-family: 'Playfair Display', serif; font-size: 28px; color: var(--savanna); }
  .advert-price span { font-size: 13px; color: var(--sand); font-family: 'Montserrat', sans-serif; }
  .partners-showcase { max-width: 1200px; margin: 0 auto; }
  .partners-showcase h3 {
    font-family: 'Playfair Display', serif; font-style: italic;
    font-size: 22px; color: var(--savanna); text-align: center; margin-bottom: 40px;
  }
  .partner-listings {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: 20px;
  }
  .partner-card {
    background: rgba(44,24,16,0.7); border: 1px solid rgba(212,168,83,0.15);
    overflow: hidden; transition: all 0.3s;
  }
  .partner-card:hover { border-color: rgba(212,168,83,0.4); }
  .partner-img-placeholder {
    height: 200px; background-size: cover; background-position: center; position: relative;
  }
  .partner-badge {
    position: absolute; top: 15px; left: 15px;
    background: var(--rust); color: var(--white);
    font-size: 9px; letter-spacing: 2px; text-transform: uppercase;
    font-weight: 700; padding: 5px 12px;
  }
  .partner-info { padding: 25px; }
  .partner-name {
    font-family: 'Playfair Display', serif; font-size: 20px; color: var(--cream); margin-bottom: 6px;
  }
  .partner-location { font-size: 12px; color: var(--savanna); letter-spacing: 1px; margin-bottom: 10px; }
  .partner-desc { font-size: 13px; color: var(--sand); line-height: 1.6; margin-bottom: 15px; }
  .partner-stars { color: var(--savanna); font-size: 14px; margin-bottom: 15px; }
  .partner-contact { display: flex; gap: 10px; }
  .partner-btn {
    padding: 10px 20px; font-size: 10px; letter-spacing: 2px;
    text-transform: uppercase; font-weight: 600; cursor: pointer; border: none; transition: all 0.3s;
  }
  .partner-btn.primary { background: var(--rust); color: var(--white); }
  .partner-btn.secondary { background: transparent; border: 1px solid rgba(212,168,83,0.4); color: var(--savanna); }
  .partner-btn:hover { opacity: 0.8; }
  .advertise-form-section {
    max-width: 700px; margin: 80px auto 0;
    background: rgba(44,24,16,0.6); border: 1px solid rgba(212,168,83,0.2); padding: 60px;
  }
  .advertise-form-section h3 {
    font-family: 'Playfair Display', serif; font-size: 28px; color: var(--savanna); margin-bottom: 8px;
  }
  .advertise-form-section p { color: var(--sand); font-size: 14px; margin-bottom: 35px; }

  /* ── TESTIMONIALS ────────────────────────────────────── */
  #testimonials { padding: 100px 60px; background: var(--cream); position: relative; }
  #testimonials .section-title { color: var(--earth); }
  .testimonials-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 30px; max-width: 1100px; margin: 0 auto;
  }
  .testimonial-card {
    background: var(--white); padding: 40px 35px;
    border-left: 3px solid var(--rust); position: relative;
  }
  .testimonial-quote {
    font-family: 'Playfair Display', serif; font-size: 60px;
    color: var(--rust); line-height: 0.5; margin-bottom: 15px; opacity: 0.5;
  }
  .testimonial-text {
    font-family: 'Libre Baskerville', serif; font-style: italic;
    color: #4A3020; font-size: 15px; line-height: 1.8; margin-bottom: 25px;
  }
  .testimonial-author { font-weight: 700; font-size: 14px; color: var(--earth); }
  .testimonial-origin { font-size: 12px; color: var(--rust); letter-spacing: 1px; margin-top: 3px; }

  /* ── FOOTER ──────────────────────────────────────────── */
  footer {
    background: var(--dark); padding: 80px 60px 40px;
    border-top: 1px solid rgba(212,168,83,0.15);
  }
  .footer-grid {
    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 50px; margin-bottom: 60px;
  }
  .footer-brand .logo { display: block; margin-bottom: 20px; }
  .footer-tagline { color: var(--sand); font-size: 14px; line-height: 1.7; margin-bottom: 25px; }
  .social-links { display: flex; gap: 15px; }
  .social-link {
    width: 38px; height: 38px; border: 1px solid rgba(212,168,83,0.3);
    display: flex; align-items: center; justify-content: center;
    color: var(--savanna); text-decoration: none; font-size: 14px; transition: all 0.3s;
  }
  .social-link:hover { background: var(--savanna); color: var(--earth); }
