<script>
"use strict";



// ── CONFIG ─────────────────────────────────────────────────
// Pass these optional locals from Express when rendering this EJS view.
// WhatsApp numbers must use international digits only (no leading + or spaces).
const API_BASE = <%- JSON.stringify(typeof apiBase !== 'undefined' && apiBase ? String(apiBase).replace(/\/$/, '') : '') %>;
const CONTACT = {
  phone:     '+254 740 449 384',
  whatsapp:  <%- JSON.stringify((typeof whatsappNumber !== 'undefined' && whatsappNumber ? String(whatsappNumber) : '254740449384').replace(/\D/g, '')) %>,
  email:     'info@wildstrides.co.ke',
  bookings:  'bookings@wildstrides.co.ke',
};

// ── DOM CACHE — look up elements once, reuse everywhere ───
const dom = {
  nav:          () => document.getElementById('mainNav'),
  pageHome:     () => document.getElementById('page-home'),
  pageAbout:    () => document.getElementById('page-about'),
  navAbout:     () => document.getElementById('navAbout'),
  modal:        () => document.getElementById('bookingModal'),
  bookingForm:  () => document.getElementById('bookingForm'),
  toast:        () => document.getElementById('toast'),
  guestName:    () => document.getElementById('guestName'),
  guestEmail:   () => document.getElementById('guestEmail'),
  travelDate:   () => document.getElementById('travelDate'),
  numGuests:    () => document.getElementById('numGuests'),
  specialReq:   () => document.getElementById('specialRequests'),
  totalAmount:  () => document.getElementById('totalAmount'),
  pkgLabel:     () => document.getElementById('bookingPackageName'),
  bookingBtn:   () => document.getElementById('bookingBtn'),
};

// ── PAGE STATE ─────────────────────────────────────────────
let currentPage    = 'home';
let currentPackage = '';
let basePrice      = 0;
let toastTimer     = null;
let previousFocus  = null;

// ── PAGE SWITCHER ──────────────────────────────────────────
function showPage(page) {
  if (page === currentPage) {
    // Already on this page — just scroll to top
    window.scrollTo({ top: 0, behavior: 'smooth' });
    return;
  }
  currentPage = page;
  dom.pageHome().style.display  = page === 'home'  ? 'block' : 'none';
  dom.pageAbout().style.display = page === 'about' ? 'block' : 'none';
  window.scrollTo({ top: 0, behavior: 'smooth' });

  const navAbout = dom.navAbout();
  if (navAbout) {
    navAbout.style.color   = page === 'about' ? 'var(--savanna)' : '';
    navAbout.style.opacity = page === 'about' ? '1' : '';
  }
}

// ── NAVIGATE TO PAGE + SECTION ─────────────────────────────
// Replaces all the showPage + setTimeout + navScrollTo patterns
function navigateTo(page, sectionId) {
  if (currentPage !== page) {
    showPage(page);
    // Wait for display:block to take effect before scrolling
    requestAnimationFrame(() => {
      requestAnimationFrame(() => navScrollTo(sectionId));
    });
  } else {
    navScrollTo(sectionId);
  }
}

// ── OPEN BOOKING FROM ABOUT PAGE ───────────────────────────
function openFromAbout(pkg, price) {
  showPage('home');
  requestAnimationFrame(() => {
    requestAnimationFrame(() => openBooking(pkg, price));
  });
}

// ── SMOOTH SCROLL ──────────────────────────────────────────
function navScrollTo(id) {
  const el = document.getElementById(id);
  if (el) el.scrollIntoView({ behavior: 'smooth' });
}

// ── NAV SCROLL HIGHLIGHT ───────────────────────────────────
window.addEventListener('scroll', () => {
  dom.nav().classList.toggle('scrolled', window.scrollY > 80);
}, { passive: true });

// ── BOOKING MODAL ──────────────────────────────────────────
function getLocalDateValue(date = new Date()) {
  const local = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
  return local.toISOString().slice(0, 10);
}

function openBooking(packageName, price) {
  currentPackage = String(packageName || '').trim();
  const numericPrice = Number(price);
  basePrice = Number.isFinite(numericPrice) && numericPrice >= 0 ? numericPrice : 0;

  const form = document.getElementById('bookingRequestForm');
  if (form) form.reset();
  dom.bookingForm().style.display = 'block';
  dom.pkgLabel().textContent = currentPackage;
  updateTotal();
  dom.travelDate().min = getLocalDateValue();

  previousFocus = document.activeElement;
  dom.modal().classList.add('active');
  dom.modal().setAttribute('aria-hidden', 'false');
  document.body.style.overflow = 'hidden';
  requestAnimationFrame(() => dom.guestName().focus());
}

function closeModal() {
  dom.modal().classList.remove('active');
  dom.modal().setAttribute('aria-hidden', 'true');
  document.body.style.overflow = '';
  if (previousFocus && typeof previousFocus.focus === 'function') previousFocus.focus();
}

dom.modal().addEventListener('click', (e) => {
  if (e.target === dom.modal()) closeModal();
});

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && dom.modal().classList.contains('active')) closeModal();
});

// Packages priced per couple (everything else is per person)
const PER_COUPLE_PACKAGES = ['Romantic Highlands Escape'];
// Partner listings where the price is a starting rate, not a trip total
const FROM_PRICE_PACKAGES = ['Sirimon River Lodge', 'Summit Ridge Guide', 'Ol Pejeta Bush Camp'];

function getPriceEstimate(guests) {
  if (basePrice === 0) {
    return { label: 'Ask for a quote', text: 'Custom quote requested' };
  }
  const usd = (n) => '$' + n.toLocaleString('en-US');
  if (FROM_PRICE_PACKAGES.some((p) => currentPackage.startsWith(p))) {
    return { label: 'From ' + usd(basePrice), text: `from ${usd(basePrice)} USD; final price to be confirmed` };
  }
  const units = PER_COUPLE_PACKAGES.includes(currentPackage) ? Math.ceil(guests / 2) : guests;
  const total = usd(basePrice * units);
  return { label: total, text: `${total} USD estimated; final price to be confirmed` };
}

function updateTotal() {
  const guests = parseInt(dom.numGuests().value, 10) || 1;
  dom.totalAmount().textContent = getPriceEstimate(guests).label;
}

// ── EMAIL VALIDATION ───────────────────────────────────────
function isValidEmail(email) {
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
}

// ── WHATSAPP LINK HELPERS ───────────────────────────────────
function createWhatsAppUrl(message) {
  const number = String(CONTACT.whatsapp || '').replace(/\D/g, '');
  if (!/^[1-9]\d{7,14}$/.test(number)) return null;
  return `https://wa.me/${number}?text=${encodeURIComponent(message)}`;
}

function openWhatsApp(url) {
  if (!url) return false;
  window.open(url, '_blank', 'noopener,noreferrer');
  return true;
}

const whatsappButton = document.getElementById('whatsappBtn');
if (whatsappButton) {
  whatsappButton.href = createWhatsAppUrl("Hi WildStrides! I'm interested in a Mt. Kenya adventure.") || '#';
}

// ── WHATSAPP BOOKING ENQUIRY ───────────────────────────────
function processBooking(event) {
  event.preventDefault();
  const name = dom.guestName().value.trim();
  const email = dom.guestEmail().value.trim();
  const date = dom.travelDate().value;
  const guests = parseInt(dom.numGuests().value, 10) || 1;
  const special = dom.specialReq().value.trim();

  if (!name) {
    dom.guestName().focus();
    showToast('Please enter your full name.');
    return;
  }
  if (email && !isValidEmail(email)) {
    dom.guestEmail().focus();
    showToast('Please enter a valid email address.');
    return;
  }
  if (!date || date < getLocalDateValue()) {
    dom.travelDate().focus();
    showToast('Please choose today or a future travel date.');
    return;
  }

  const dateFormatted = new Date(`${date}T12:00:00`).toLocaleDateString('en-KE', {
    weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
  });
  const estimate = getPriceEstimate(guests).text;
  const message = [
    "Hi WildStrides! I'd like to enquire about a Mt. Kenya trip:",
    '',
    `Package: ${currentPackage}`,
    `Preferred date: ${dateFormatted}`,
    `Guests: ${guests}${guests === 5 ? '+' : ''}`,
    `Estimated price: ${estimate}`,
    `Name: ${name}`,
    email ? `Email: ${email}` : null,
    special ? `Special requests: ${special}` : null,
    '',
    'Please confirm availability, final pricing and payment instructions. I understand this is an enquiry, not a confirmed booking.'
  ].filter((line) => line !== null).join('\n');

  const url = createWhatsAppUrl(message);
  if (!url) {
    showToast('WhatsApp booking is not configured. Please contact the site owner.');
    return;
  }
  openWhatsApp(url);
  closeModal();
  showToast('WhatsApp opened with your enquiry. Send the message there to contact our team.');
}

// ── PARTNER FORM ───────────────────────────────────────────
async function submitPartnerForm(e) {
  e.preventDefault();
  const form = e.target;
  const btn = form.querySelector('button[type=submit]');
  const textInputs = form.querySelectorAll('input[type=text]');
  const selects = form.querySelectorAll('select');
  const data = {
    businessName: textInputs[0]?.value.trim() || '',
    contactName: textInputs[1]?.value.trim() || '',
    phone: form.querySelector('input[type=tel]')?.value.trim() || '',
    email: form.querySelector('input[type=email]')?.value.trim() || '',
    businessType: selects[0]?.value || '',
    location: textInputs[2]?.value.trim() || '',
    adPackage: selects[1]?.value || '',
  };

  if (!data.email || !isValidEmail(data.email)) {
    showToast('Please enter a valid email address.');
    return;
  }

  const originalText = btn.textContent;
  btn.disabled = true;
  btn.textContent = 'Submitting...';
  try {
    if (API_BASE) {
      await apiFetch('/api/partners/inquiry', data);
      showToast("Partnership request sent. We'll be in touch.");
    } else {
      const message = [
        'Hi WildStrides! I would like to enquire about a business partnership:',
        '',
        `Business: ${data.businessName}`,
        `Contact: ${data.contactName}`,
        `Phone: ${data.phone}`,
        `Email: ${data.email}`,
        `Business type: ${data.businessType}`,
        `Location: ${data.location}`,
        `Package interest: ${data.adPackage}`
      ].join('\n');
      const url = createWhatsAppUrl(message);
      if (!url) throw new Error('WhatsApp contact is not configured.');
      openWhatsApp(url);
      showToast('WhatsApp opened with your partnership enquiry. Send the message there.');
    }
    form.reset();
  } catch (err) {
    console.error('Partner form error:', err);
    showToast(err.message || 'Could not send your request. Please try again.');
  } finally {
    btn.disabled = false;
    btn.textContent = originalText;
  }
}

// ── REUSABLE API FETCH ─────────────────────────────────────
async function apiFetch(endpoint, body) {
  const res = await fetch(API_BASE + endpoint, {
    method:  'POST',
    headers: { 'Content-Type': 'application/json' },
    body:    JSON.stringify(body),
  });

  if (!res.ok) {
    const err = await res.json().catch(() => ({}));
    throw new Error(err.error || `Server error ${res.status}`);
  }

  const data = await res.json();
  if (data.error) throw new Error(data.error);
  return data;
}

// ── TOAST NOTIFICATION ─────────────────────────────────────
function showToast(msg, duration = 4000) {
  const toast       = dom.toast();
  toast.textContent = msg;
  toast.classList.add('show');

  // Clear any existing timer before setting a new one
  if (toastTimer) clearTimeout(toastTimer);
  toastTimer = setTimeout(() => {
    toast.classList.remove('show');
    toastTimer = null;
  }, duration);
}
  

</script>

