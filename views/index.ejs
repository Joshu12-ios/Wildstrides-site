        <div class="dest-highlights">
          <span class="highlight-tag">Trekking</span>
          <span class="highlight-tag">Glaciers</span>
          <span class="highlight-tag">Alpine Flora</span>
        </div>
        <div class="dest-footer">
          <div class="dest-price">$320 <span>/ person</span></div>
          <button class="dest-btn">Explore →</button>
        </div>
      </div>
    </div>

