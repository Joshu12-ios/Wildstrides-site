  .cta-btn-white { background: var(--white); color: var(--rust); border: none; padding: 17px 42px; font-family: 'Montserrat', sans-serif; font-size: 11px; letter-spacing: 3px; text-transform: uppercase; font-weight: 700; cursor: pointer; transition: all .3s; }
