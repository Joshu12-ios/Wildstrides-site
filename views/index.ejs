     HOME PAGE
═══════════════════════════════════════════════════════ -->
<div id="page-home">

<!-- HERO -->
<section id="hero">
  <div class="hero-bg"></div>
  <div class="hero-content">
    <p class="hero-eyebrow">🏔️ Mt. Kenya Region — Africa's Alpine Crown</p>
    <h1 class="hero-title">
      WILD
      <em>Strides</em>
    </h1>
    <p class="hero-sub">Where the equator meets the snow line. Discover Kenya's most dramatic landscapes — from misty montane forests to open savannah at the foot of Africa's second highest peak.</p>
