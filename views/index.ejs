  .value-card.vc-sage .value-text  { color: rgba(255,255,255,.85); }
  .value-bg-letter { position: absolute; bottom: -15px; right: 8px; font-family: 'Playfair Display', serif; font-size: 120px; font-weight: 900; color: rgba(212,168,83,.05); line-height: 1; pointer-events: none; }
  .value-card.vc-rust .value-bg-letter,
  .value-card.vc-sage .value-bg-letter { color: rgba(255,255,255,.07); }
  .value-icon { font-size: 34px; margin-bottom: 18px; display: block; }
  .value-title { font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; color: var(--savanna); margin-bottom: 13px; }
  .value-text  { font-family: 'Libre Baskerville', serif; font-size: 14px; color: var(--sand); line-height: 1.85; }

  /* ── ABOUT — TEAM ────────────────────────────────────── */
