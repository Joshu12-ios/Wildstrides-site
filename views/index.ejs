  .stat-block:hover { background: rgba(212,168,83,.06); }
  .stat-number { font-family: 'Playfair Display', serif; font-size: clamp(44px,5vw,68px); font-weight: 900; color: var(--savanna); line-height: 1; display: block; }
  .stat-label { font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: var(--sand); margin-top: 10px; display: block; font-weight: 600; }
  .stat-desc { font-size: 11px; color: rgba(232,213,163,.45); margin-top: 7px; font-style: italic; }

  /* ── ABOUT — VALUES ──────────────────────────────────── */
