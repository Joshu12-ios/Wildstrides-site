  .why-badge strong { font-family: 'Playfair Display', serif; font-size: 30px; font-weight: 900; display: block; line-height: 1; }
  .why-badge span { font-size: 8px; letter-spacing: 1.5px; text-transform: uppercase; font-weight: 700; display: block; margin-top: 4px; }

