  /* ── ABOUT — SHARED TYPOGRAPHY ───────────────────────── */
  .ab-section-tag { font-size: 10px; letter-spacing: 5px; text-transform: uppercase; color: var(--rust); font-weight: 700; display: block; margin-bottom: 13px; }
  .ab-section-title { font-family: 'Playfair Display', serif; font-size: clamp(32px, 4.5vw, 56px); font-weight: 900; line-height: 1.06; }
