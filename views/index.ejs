  .cta-btn-outline { background: transparent; color: var(--white); border: 1.5px solid rgba(255,255,255,.6); padding: 17px 42px; font-family: 'Montserrat', sans-serif; font-size: 11px; letter-spacing: 3px; text-transform: uppercase; font-weight: 600; cursor: pointer; transition: all .3s; }
